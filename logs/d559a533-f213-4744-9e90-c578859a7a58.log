13	 public LoginResponse login(LoginRequest request) { Employee e; try { e=employees.getByEmail(request.email()); } catch(NotFoundException ex) { throw new UnauthorizedException("Invalid email or password"); } if(!encoder.matches(request.password(),e.getPasswordHash())) throw new UnauthorizedException("Invalid email or password"); return new LoginResponse(jwt.issue(e),"Bearer",e.getId(),e.getEmail(),e.getRole()); }
14	}
