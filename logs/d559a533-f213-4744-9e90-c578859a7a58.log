```java
1	package com.enterprise.hr.service;
2	
3	import com.enterprise.hr.domain.Employee;
4	import com.enterprise.hr.domain.LeaveRequest;
5	import com.enterprise.hr.domain.LeaveStatus;
6	import com.enterprise.hr.dto.CreateLeaveRequest;
7	import com.enterprise.hr.dto.LeaveDecisionRequest;
8	import com.enterprise.hr.dto.LeaveRequestResponse;
9	import com.enterprise.hr.exception.BusinessRuleException;
10	import com.enterprise.hr.repository.LeaveEmployeeLookup;
11	import com.enterprise.hr.repository.LeaveRequestRepository;
12	import org.springframework.http.HttpStatus;
13	import org.springframework.stereotype.Service;
14	import org.springframework.transaction.annotation.Transactional;
15	
16	import java.time.LocalDate;
17	import java.time.temporal.ChronoUnit;
18	import java.util.List;
19	
20	@Service
21	@Transactional(readOnly = true)
22	public class LeaveRequestService {
23	    private final LeaveRequestRepository leaveRequests;
24	    private final LeaveEmployeeLookup employees;
25	
26	    public LeaveRequestService(LeaveRequestRepository leaveRequests, LeaveEmployeeLookup employees) {
27	        this.leaveRequests = leaveRequests;
28	        this.employees = employees;
29	    }
30	
31	    @Transactional
32	    public LeaveRequestResponse create(String callerEmail, CreateLeaveRequest command) {
33	        validateRange(command.startDate(), command.endDate());
34	        Employee employee = employeeFor(callerEmail);
35	        LeaveRequest request = new LeaveRequest(employee, command.startDate(), command.endDate(), command.reason().trim());
36	        return toResponse(leaveRequests.save(request));
37	    }
38	
39	    public List<LeaveRequestResponse> mine(String callerEmail) {
40	        // Resolving the caller first prevents an unknown principal from receiving an empty success response.
41	        employeeFor(callerEmail);
42	        return leaveRequests.findByEmployeeEmailOrderByRequestedAtDesc(callerEmail).stream()
43	                .map(this::toResponse)
44	                .toList();
45	    }
46	
47	    public List<LeaveRequestResponse> pendingSubordinates(String callerEmail) {
48	        employeeFor(callerEmail);
49	        return leaveRequests.findByEmployeeManagerEmailAndStatusOrderByRequestedAtAsc(callerEmail, LeaveStatus.PENDING)
50	                .stream().map(this::toResponse).toList();
51	    }
52	
53	    @Transactional
54	    public LeaveRequestResponse decide(String callerEmail, Long requestId, LeaveDecisionRequest command) {
55	        if (command.status() != LeaveStatus.APPROVED && command.status() != LeaveStatus.REJECTED) {
56	            throw new BusinessRuleException("INVALID_LEAVE_DECISION", "A leave request can only be approved or rejected");
57	        }
58	
59	        Employee manager = employeeFor(callerEmail);
60	        LeaveRequest request = leaveRequests.findForDecisionById(requestId)
61	                .orElseThrow(() -> new BusinessRuleException("LEAVE_REQUEST_NOT_FOUND", "Leave request was not found", HttpStatus.NOT_FOUND));
62	
63	        if (request.getStatus() != LeaveStatus.PENDING) {
64	            throw new BusinessRuleException("LEAVE_REQUEST_ALREADY_DECIDED", "Only pending leave requests can be decided");
65	        }
66	        Employee requestManager = request.getEmployee().getManager();
67	        if (requestManager == null || !callerEmail.equalsIgnoreCase(requestManager.getEmail())) {
68	            throw new BusinessRuleException("NOT_DIRECT_MANAGER", "Only the employee's direct manager may decide this leave request", HttpStatus.FORBIDDEN);
69	        }
70	
71	        if (command.status() == LeaveStatus.APPROVED) {
72	            ensureApprovalAllowed(request);
73	        }
74	        request.decide(command.status(), manager, normalize(command.comment()));
75	        return toResponse(request);
76	    }
77	
78	    private void ensureApprovalAllowed(LeaveRequest request) {
79	        Long employeeId = request.getEmployee().getId();
80	        if (leaveRequests.existsByEmployeeIdAndStatusAndStartDateLessThanEqualAndEndDateGreaterThanEqual(
81	                employeeId, LeaveStatus.APPROVED, request.getEndDate(), request.getStartDate())) {
82	            throw new BusinessRuleException("OVERLAPPING_APPROVED_LEAVE", "The requested dates overlap approved leave");
83	        }
84	
85	        long alreadyApprovedDays = leaveRequests.findByEmployeeIdAndStatus(employeeId, LeaveStatus.APPROVED).stream()
86	                .mapToLong(approved -> inclusiveDays(approved.getStartDate(), approved.getEndDate()))
87	                .sum();
88	        long requestedDays = inclusiveDays(request.getStartDate(), request.getEndDate());
89	        int entitlement = request.getEmployee().getAnnualLeaveEntitlementDays();
90	        if (alreadyApprovedDays + requestedDays > entitlement) {
91	            throw new BusinessRuleException("ANNUAL_LEAVE_ENTITLEMENT_EXCEEDED",
92	                    "Approval would exceed the employee's annual leave entitlement");
93	        }
94	    }
95	
96	    private Employee employeeFor(String email) {
97	        if (email == null || email.isBlank()) {
98	            throw new BusinessRuleException("UNAUTHENTICATED_CALLER", "An authenticated caller email is required", HttpStatus.UNAUTHORIZED);
99	        }
100	        return employees.findByEmail(email)
101	                .orElseThrow(() -> new BusinessRuleException("EMPLOYEE_NOT_FOUND", "No employee exists for the authenticated email", HttpStatus.NOT_FOUND));
102	    }
103	
104	    private void validateRange(LocalDate startDate, LocalDate endDate) {
105	        if (startDate == null || endDate == null || endDate.isBefore(startDate)) {
106	            throw new BusinessRuleException("INVALID_LEAVE_DATE_RANGE", "endDate must be on or after startDate");
107	        }
108	    }
109	
110	    private long inclusiveDays(LocalDate startDate, LocalDate endDate) {
111	        return ChronoUnit.DAYS.between(startDate, endDate) + 1;
112	    }
113	
114	    private String normalize(String value) {
115	        return value == null || value.isBlank() ? null : value.trim();
116	    }
117	
118	    private LeaveRequestResponse toResponse(LeaveRequest request) {
119	        Employee employee = request.getEmployee();
120	        Employee decidedBy = request.getDecidedBy();
121	        return new LeaveRequestResponse(request.getId(), employee.getId(), employee.getEmail(),
122	                request.getStartDate(), request.getEndDate(), request.getReason(), request.getStatus(),
123	                request.getRequestedAt(), decidedBy == null ? null : decidedBy.getId(), request.getDecidedAt(),
124	                request.getDecisionComment());
125	    }
126	}
