11	@Service @Transactional
12	public class OrganizationService {
13	 private final DepartmentRepository departments; private final DesignationRepository designations;
14	 public OrganizationService(DepartmentRepository d, DesignationRepository g) { departments=d; designations=g; }
15	 public OrganizationResponse createDepartment(OrganizationRequest r) { if(departments.existsByNameIgnoreCase(r.name())) throw new BadRequestException("Department name already exists"); Department x=new Department(); set(x,r); return department(departments.save(x)); }
16	 public List<OrganizationResponse> departments() { return departments.findAll().stream().map(this::department).toList(); }
17	 public OrganizationResponse department(Long id) { return department(departments.findById(id).orElseThrow(()->new NotFoundException("Department not found"))); }
18	 public OrganizationResponse updateDepartment(Long id, OrganizationRequest r) { Department x=departments.findById(id).orElseThrow(()->new NotFoundException("Department not found")); set(x,r); return department(x); }
19	 public void deleteDepartment(Long id) { if(!departments.existsById(id)) throw new NotFoundException("Department not found"); departments.deleteById(id); }
