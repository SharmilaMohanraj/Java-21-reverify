```java
1	package com.enterprise.hr.security;
2	
3	import com.enterprise.hr.domain.Employee;
4	import io.jsonwebtoken.*;
5	import io.jsonwebtoken.security.Keys;
6	import java.nio.charset.StandardCharsets;
7	import java.security.Key;
8	import java.time.Instant;
9	import java.util.Date;
10	import org.springframework.beans.factory.annotation.Value;
11	import org.springframework.stereotype.Service;
12	
13	@Service
14	public class JwtService {
15	 private final Key key; private final long expiration;
16	 public JwtService(@Value("${app.jwt.secret}") String secret, @Value("${app.jwt.expiration-ms:3600000}") long expiration) { if(secret.length()<32) throw new IllegalArgumentException("JWT secret must be at least 32 characters"); key=Keys.hmacShaKeyFor(secret.getBytes(StandardCharsets.UTF_8)); this.expiration=expiration; }
17	 public String issue(Employee e) { Instant now=Instant.now(); return Jwts.builder().subject(e.getEmail()).claim("role", "ROLE_"+e.getRole().name()).issuedAt(Date.from(now)).expiration(Date.from(now.plusMillis(expiration))).signWith(key).compact(); }
18	 public Claims claims(String token) { return Jwts.parser().verifyWith((javax.crypto.SecretKey)key).build().parseSignedClaims(token).getPayload(); }
19	 public String subject(String token) { return claims(token).getSubject(); }
20	 public String role(String token) { return claims(token).get("role", String.class); }
21	}
