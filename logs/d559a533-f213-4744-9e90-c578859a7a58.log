28	 private static void write(ObjectMapper mapper, HttpServletResponse response, int status, String error, String message, String path) throws java.io.IOException { response.setStatus(status); response.setContentType(MediaType.APPLICATION_JSON_VALUE); var body=new LinkedHashMap<String,Object>(); body.put("timestamp",Instant.now().toString()); body.put("status",status); body.put("error",error); body.put("message",message); body.put("path",path); mapper.writeValue(response.getOutputStream(),body); }
