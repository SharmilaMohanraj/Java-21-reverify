1	package com.enterprise.hr.service;
2	
3	import com.enterprise.hr.domain.Department;
4	import com.enterprise.hr.domain.Designation;
5	import com.enterprise.hr.domain.Employee;
6	import com.enterprise.hr.dto.EmployeeDtos.CreateEmployeeRequest;
7	import com.enterprise.hr.dto.EmployeeDtos.EmployeeResponse;
8	import com.enterprise.hr.exception.BadRequestException;
9	import com.enterprise.hr.exception.BusinessRuleException;
10	import com.enterprise.hr.exception.NotFoundException;
11	import com.enterprise.hr.repository.DepartmentRepository;
12	import com.enterprise.hr.repository.DesignationRepository;
13	import com.enterprise.hr.repository.EmployeeRepository;
14	import java.util.Locale;
15	import org.springframework.security.crypto.password.PasswordEncoder;
16	import org.springframework.stereotype.Service;
17	import org.springframework.transaction.annotation.Transactional;
18	
19	@Service
20	@Transactional
21	public class EmployeeService {
22	    private final EmployeeRepository employees;
23	    private final DepartmentRepository departments;
24	    private final DesignationRepository designations;
25	    private final PasswordEncoder encoder;
26	
27	    public EmployeeService(EmployeeRepository employees, DepartmentRepository departments,
28	                           DesignationRepository designations, PasswordEncoder encoder) {
29	        this.employees = employees;
30	        this.departments = departments;
31	        this.designations = designations;
32	        this.encoder = encoder;
33	    }
34	
35	    public EmployeeResponse create(CreateEmployeeRequest request) {
36	        String email = request.email().trim().toLowerCase(Locale.ROOT);
37	        if (employees.findByEmailIgnoreCase(email).isPresent() || employees.findByEmployeeCode(request.employeeCode().trim()).isPresent()) {
38	            throw new BusinessRuleException("DUPLICATE_EMPLOYEE", "Employee email or employee code already exists");
39	        }
40	        Employee employee = new Employee();
41	        employee.setEmployeeCode(request.employeeCode().trim());
42	        employee.setFullName(request.fullName().trim());
43	        employee.setEmail(email);
44	        employee.setPasswordHash(encoder.encode(request.password()));
45	        employee.setRole(request.role());
46	        employee.setAnnualLeaveEntitlementDays(request.annualLeaveEntitlementDays());
47	        if (request.departmentId() != null) employee.setDepartment(department(request.departmentId()));
48	        if (request.designationId() != null) employee.setDesignation(designation(request.designationId()));
49	        return response(employees.save(employee));
50	    }
51	
52	    public EmployeeResponse assignManager(Long employeeId, Long managerId) {
53	        Employee employee = get(employeeId);
54	        employee.setManager(managerId == null ? null : manager(managerId, employeeId));
55	        return response(employee);
56	    }
57	
58	    public Employee getByEmail(String email) {
59	        return employees.findByEmailIgnoreCase(email)
60	                .orElseThrow(() -> new NotFoundException("Employee not found"));
61	    }
62	
63	    private Employee get(Long id) {
64	        return employees.findById(id).orElseThrow(() -> new NotFoundException("Employee not found"));
65	    }
66	
67	    private Department department(Long id) { return departments.findById(id).orElseThrow(() -> new NotFoundException("Department not found")); }
68	    private Designation designation(Long id) { return designations.findById(id).orElseThrow(() -> new NotFoundException("Designation not found")); }
69	
70	    private Employee manager(Long id, Long employeeId) {
71	        if (id.equals(employeeId)) throw new BadRequestException("An employee cannot manage themselves");
72	        return get(id);
73	    }
74	
75	    public EmployeeResponse response(Employee employee) {
76	        return new EmployeeResponse(employee.getId(), employee.getEmployeeCode(), employee.getFullName(), employee.getEmail(),
77	                employee.getRole(), employee.getAnnualLeaveEntitlementDays(),
78	                employee.getDepartment() == null ? null : employee.getDepartment().getId(),
79	                employee.getDesignation() == null ? null : employee.getDesignation().getId(),
80	                employee.getManager() == null ? null : employee.getManager().getId());
81	    }
82	}
