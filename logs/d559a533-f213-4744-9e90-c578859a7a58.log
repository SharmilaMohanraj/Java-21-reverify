1	package com.enterprise.hr.security;
2	
3	import com.enterprise.hr.domain.Employee;
4	import com.enterprise.hr.repository.EmployeeRepository;
5	import io.jsonwebtoken.JwtException;
6	import jakarta.servlet.FilterChain;
7	import jakarta.servlet.ServletException;
8	import jakarta.servlet.http.HttpServletRequest;
9	import jakarta.servlet.http.HttpServletResponse;
10	import java.io.IOException;
11	import java.util.List;
12	import org.springframework.http.HttpHeaders;
13	import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
14	import org.springframework.security.core.authority.SimpleGrantedAuthority;
15	import org.springframework.security.core.context.SecurityContextHolder;
16	import org.springframework.stereotype.Component;
17	import org.springframework.web.filter.OncePerRequestFilter;
18	
19	@Component
20	public class JwtAuthenticationFilter extends OncePerRequestFilter {
21	    private final JwtService jwt;
22	    private final EmployeeRepository employeeRepository;
23	
24	    public JwtAuthenticationFilter(JwtService jwt, EmployeeRepository employeeRepository) {
25	        this.jwt = jwt;
26	        this.employeeRepository = employeeRepository;
27	    }
28	
29	    @Override
30	    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
31	            throws ServletException, IOException {
32	        String header = request.getHeader(HttpHeaders.AUTHORIZATION);
33	        if (header != null && header.startsWith("Bearer ")) {
34	            try {
35	                String subject = jwt.subject(header.substring(7));
36	                if (subject == null || subject.isBlank()) {
37	                    SecurityContextHolder.clearContext();
38	                } else {
39	                    employeeRepository.findByEmailIgnoreCase(subject)
40	                            .filter(employee -> employee.getRole() != null)
41	                            .ifPresentOrElse(this::authenticate, SecurityContextHolder::clearContext);
42	                }
43	            } catch (JwtException | IllegalArgumentException ignored) {
44	                SecurityContextHolder.clearContext();
45	            }
46	        }
47	        chain.doFilter(request, response);
48	    }
49	
50	    private void authenticate(Employee employee) {
51	        String authority = "ROLE_" + employee.getRole().name();
52	        var authentication = new UsernamePasswordAuthenticationToken(
53	                employee.getEmail(), null, List.of(new SimpleGrantedAuthority(authority)));
54	        SecurityContextHolder.getContext().setAuthentication(authentication);
55	    }
56	}
