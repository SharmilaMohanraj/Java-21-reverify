1	package com.enterprise.hr.exception;
2	
3	import jakarta.servlet.http.HttpServletRequest;
4	import java.time.Instant;
5	import java.util.LinkedHashMap;
6	import java.util.Map;
7	import org.springframework.dao.DataIntegrityViolationException;
8	import org.springframework.http.HttpStatus;
9	import org.springframework.http.ResponseEntity;
10	import org.springframework.security.access.AccessDeniedException;
11	import org.springframework.security.core.AuthenticationException;
12	import org.springframework.web.bind.MethodArgumentNotValidException;
13	import org.springframework.web.bind.annotation.ExceptionHandler;
14	import org.springframework.web.bind.annotation.RestControllerAdvice;
15	
16	@RestControllerAdvice
17	public class ApiExceptionHandler {
18	    @ExceptionHandler({NotFoundException.class, ResourceNotFoundException.class})
19	    public ResponseEntity<Map<String, Object>> notFound(RuntimeException exception, HttpServletRequest request) {
20	        return response(HttpStatus.NOT_FOUND, exception.getMessage(), request);
21	    }
22	
23	    @ExceptionHandler({UnauthorizedException.class, AuthenticationException.class})
24	    public ResponseEntity<Map<String, Object>> unauthorized(Exception exception, HttpServletRequest request) {
25	        return response(HttpStatus.UNAUTHORIZED, exception.getMessage(), request);
26	    }
27	
28	    @ExceptionHandler(AccessDeniedException.class)
29	    public ResponseEntity<Map<String, Object>> forbidden(AccessDeniedException exception, HttpServletRequest request) {
30	        return response(HttpStatus.FORBIDDEN, "Access is denied", request);
31	    }
32	
33	    @ExceptionHandler(BusinessRuleException.class)
34	    public ResponseEntity<Map<String, Object>> conflict(BusinessRuleException exception, HttpServletRequest request) {
35	        return response(exception.getStatus(), exception.getMessage(), request);
36	    }
37	
38	    @ExceptionHandler({BadRequestException.class, MethodArgumentNotValidException.class, DataIntegrityViolationException.class})
39	    public ResponseEntity<Map<String, Object>> bad(Exception exception, HttpServletRequest request) {
40	        String message = exception instanceof MethodArgumentNotValidException validation
41	                ? validation.getBindingResult().getFieldErrors().stream().findFirst()
42	                    .map(error -> error.getField() + ": " + error.getDefaultMessage()).orElse("Validation failed")
43	                : exception.getMessage();
44	        return response(HttpStatus.BAD_REQUEST, message, request);
45	    }
46	
47	    private ResponseEntity<Map<String, Object>> response(HttpStatus status, String message, HttpServletRequest request) {
48	        Map<String, Object> body = new LinkedHashMap<>();
49	        body.put("timestamp", Instant.now().toString());
50	        body.put("status", status.value());
51	        body.put("error", status.getReasonPhrase());
52	        body.put("message", message == null ? status.getReasonPhrase() : message);
53	        body.put("path", request.getRequestURI());
54	        return ResponseEntity.status(status).body(body);
55	    }
56	}
