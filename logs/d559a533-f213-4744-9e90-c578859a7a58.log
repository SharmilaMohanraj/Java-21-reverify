14	        @NotNull LocalDate periodStart,
15	        @NotNull LocalDate periodEnd,
16	        @NotNull @DecimalMin(value = "0.00") @Digits(integer = 17, fraction = 2) BigDecimal grossPay,
17	        @NotNull @DecimalMin(value = "0.00") @Digits(integer = 17, fraction = 2) BigDecimal deductions,
18	        @NotNull @DecimalMin(value = "0.00") @Digits(integer = 17, fraction = 2) BigDecimal netPay
19	) {
20	    @AssertTrue(message = "period end must not be before period start")
21	    public boolean isValidPeriod() {
22	        return periodStart == null || periodEnd == null || !periodEnd.isBefore(periodStart);
23	    }
24	
25	    @AssertTrue(message = "net pay must equal gross pay minus deductions")
26	    public boolean isNetPayConsistent() {
27	        return grossPay == null || deductions == null || netPay == null
28	                || grossPay.subtract(deductions).compareTo(netPay) == 0;
