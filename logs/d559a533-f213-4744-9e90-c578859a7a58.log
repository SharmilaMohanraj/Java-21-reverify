1	package com.enterprise.hr.service;
2	
3	import com.enterprise.hr.domain.*;
4	import com.enterprise.hr.dto.EmployeeDtos.*;
5	import com.enterprise.hr.exception.*;
6	import com.enterprise.hr.repository.*;
7	import java.util.Locale;
8	import org.springframework.security.crypto.password.PasswordEncoder;
9	import org.springframework.stereotype.Service;
10	import org.springframework.transaction.annotation.Transactional;
11	
12	@Service @Transactional
13	public class EmployeeService {
14	    private final EmployeeRepository employees; private final DepartmentRepository departments; private final DesignationRepository designations; private final PasswordEncoder encoder;
15	    public EmployeeService(EmployeeRepository e, DepartmentRepository d, DesignationRepository g, PasswordEncoder p) { employees=e; departments=d; designations=g; encoder=p; }
16	    public EmployeeResponse create(CreateEmployeeRequest r) {
17	        String email=r.email().trim().toLowerCase(Locale.ROOT);
18	        if (employees.findByEmailIgnoreCase(email).isPresent()) throw new BadRequestException("Email already exists");
19	        Employee e=new Employee(); e.setFirstName(r.firstName().trim()); e.setLastName(r.lastName().trim()); e.setEmail(email); e.setPasswordHash(encoder.encode(r.password())); e.setRole(r.role());
20	        if(r.departmentId()!=null) e.setDepartment(departments.findById(r.departmentId()).orElseThrow(()->new NotFoundException("Department not found")));
21	        if(r.designationId()!=null) e.setDesignation(designations.findById(r.designationId()).orElseThrow(()->new NotFoundException("Designation not found")));
22	        if(r.managerId()!=null) e.setManager(manager(r.managerId(), null));
23	        return response(employees.save(e));
24	    }
25	    public EmployeeResponse assignManager(Long employeeId, Long managerId) { Employee e=get(employeeId); e.setManager(manager(managerId, employeeId)); return response(e); }
26	    public Employee getByEmail(String email) { return employees.findByEmailIgnoreCase(email).orElseThrow(()->new NotFoundException("Employee not found")); }
27	    private Employee get(Long id) { return employees.findById(id).orElseThrow(()->new NotFoundException("Employee not found")); }
28	    private Employee manager(Long id, Long employeeId) { if(id.equals(employeeId)) throw new BadRequestException("An employee cannot manage themselves"); Employee m=get(id); if(m.getRole()!=Role.MANAGER && m.getRole()!=Role.HR) throw new BadRequestException("Manager must have MANAGER or HR role"); return m; }
29	    public EmployeeResponse response(Employee e) { return new EmployeeResponse(e.getId(),e.getFirstName(),e.getLastName(),e.getEmail(),e.getRole(),e.getDepartment()==null?null:e.getDepartment().getId(),e.getDesignation()==null?null:e.getDesignation().getId(),e.getManager()==null?null:e.getManager().getId()); }
30	}
