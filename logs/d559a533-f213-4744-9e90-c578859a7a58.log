7	import java.util.List;
8	import org.springframework.stereotype.Service;
9	import org.springframework.transaction.annotation.Transactional;
10	
11	@Service @Transactional
12	public class OrganizationService {
13	 private final DepartmentRepository departments; private final DesignationRepository designations; private final EmployeeRepository employees;
14	 public OrganizationService(DepartmentRepository d, DesignationRepository g, EmployeeRepository e) { departments=d; designations=g; employees=e; }
15	 public OrganizationResponse createDepartment(OrganizationRequest r) { if(departments.existsByNameIgnoreCase(r.name())) throw new BadRequestException("Department name already exists"); Department x=new Department(); set(x,r); return department(departments.save(x)); }
16	 public List<OrganizationResponse> departments() { return departments.findAll().stream().map(this::department).toList(); }
17	 public OrganizationResponse department(Long id) { return department(departments.findById(id).orElseThrow(()->new NotFoundException("Department not found"))); }
18	 public OrganizationResponse updateDepartment(Long id, OrganizationRequest r) { Department x=departments.findById(id).orElseThrow(()->new NotFoundException("Department not found")); set(x,r); return department(x); }
19	 public void deleteDepartment(Long id) {
20	  if(!departments.existsById(id)) throw new NotFoundException("Department not found");
21	  if(employees.existsByDepartmentId(id)) throw new BusinessRuleException("DEPARTMENT_ASSIGNED", "Department has employee assignments and cannot be deleted");
22	  departments.deleteById(id);
23	 }
24	 public OrganizationResponse createDesignation(OrganizationRequest r) { if(designations.existsByNameIgnoreCase(r.name())) throw new BadRequestException("Designation name already exists"); Designation x=new Designation(); set(x,r); return designation(designations.save(x)); }
25	 public List<OrganizationResponse> designations() { return designations.findAll().stream().map(this::designation).toList(); }
26	 public OrganizationResponse designation(Long id) { return designation(designations.findById(id).orElseThrow(()->new NotFoundException("Designation not found"))); }
27	 public OrganizationResponse updateDesignation(Long id, OrganizationRequest r) { Designation x=designations.findById(id).orElseThrow(()->new NotFoundException("Designation not found")); set(x,r); return designation(x); }
28	 public void deleteDesignation(Long id) {
29	  if(!designations.existsById(id)) throw new NotFoundException("Designation not found");
30	  if(employees.existsByDesignationId(id)) throw new BusinessRuleException("DESIGNATION_ASSIGNED", "Designation has employee assignments and cannot be deleted");
31	  designations.deleteById(id);
32	 }
33	 private void set(Department x, OrganizationRequest r) { x.setName(r.name().trim()); x.setDescription(r.description()); } private void set(Designation x, OrganizationRequest r) { x.setName(r.name().trim()); x.setDescription(r.description()); }
34	 private OrganizationResponse department(Department x) { return new OrganizationResponse(x.getId(),x.getName(),x.getDescription()); } private OrganizationResponse designation(Designation x) { return new OrganizationResponse(x.getId(),x.getName(),x.getDescription()); }
35	}
